app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local machine configuration and credentials (all directories)
local.properties
key.properties
.env
.env.*
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# Local IDE state and native build caches
.vscode/
.gradle/
.cxx/

# Installable packages, signing sidecars and crash dumps
*.apk
*.aab
*.apks
*.idsig
*.hprof
*.dmp

# Local-only handoff documents
/PROJECT_HANDOFF.md
/GITHUB_MAINTENANCE_HANDOFF.md

# Local records, temporary files and backup folders
/records/
/offline-test-records/
/tmp/
/temp/
/backups/
